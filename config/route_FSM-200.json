     "angle_deg": {"low": 30.0, "high": 60.0}, "max_retries": 1},
    {"op": "OP40", "name": "Brake caliper install", "type": "torque",
     "scan_component": "caliper", "bolts": 2,
     "torque_nm": {"low": 112.0, "target": 120.0, "high": 128.0},
     "angle_deg": {"low": 20.0, "high": 50.0}, "max_retries": 1},
    {"op": "OP50", "name": "End-of-line inspection", "type": "inspection",
     "checks": ["visual", "caliper_orientation", "dmc_readable"]},
    {"op": "OP60", "name": "Pack & RFID ship label", "type": "pack",
     "rack_capacity": 12}
  ],
  "rework_station": {"op": "RW01", "name": "Rework bench", "return_to": "failed_op"}
